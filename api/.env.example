# Documentation only: the API reads the process environment, not .env files.
# Mock mode is the default and uses no AWS credentials or network services.
APP_DATA_MODE=mock

# Only needed later for the explicitly selected APP_DATA_MODE=dynamodb path.
# Tables must already exist; no seed or table creation occurs at API startup.
# DYNAMODB_REGION=eu-central-1
# DYNAMODB_CONSUMPTION_TABLE=g4-greentrack-demo-consumption
# DYNAMODB_ANOMALIES_TABLE=g4-greentrack-demo-anomalies
# DYNAMODB_FORECASTS_TABLE=g4-greentrack-demo-forecasts
# Optional: one active 24-hour illustrative run (default matches our fixtures).
# DYNAMODB_FORECAST_ORIGIN=2009-06-08T00:00:00Z
